# Diligent Engine exports no package config of its own, so this file declares the
# installed combined static libraries as imported targets.
#
# Generated by the port from unofficial-diligent-engine-config.cmake.in.

get_filename_component(_diligent_prefix "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)

# Diligent's public headers refuse to compile unless the platform is named, and
# they switch on the backend macros, so consumers need the same definitions the
# engine itself was built with. Upstream carries these on its
# Diligent-PublicBuildSettings interface target, which is not installed.
set(_diligent_definitions "@DILIGENT_PUBLIC_DEFINITIONS@")

set(_diligent_include_dirs
    "${_diligent_prefix}/include"
    "${_diligent_prefix}/include/DiligentCore"
)
if(EXISTS "${_diligent_prefix}/include/DiligentTools")
    list(APPEND _diligent_include_dirs "${_diligent_prefix}/include/DiligentTools")
endif()
if(EXISTS "${_diligent_prefix}/include/DiligentFX")
    list(APPEND _diligent_include_dirs "${_diligent_prefix}/include/DiligentFX")
endif()

# Declares unofficial::diligent-engine::<name> for a module, wiring up the
# release/debug library pair that the port flattened into lib/ and debug/lib/.
function(_diligent_add_module name)
    if(TARGET unofficial::diligent-engine::${name})
        return()
    endif()

    set(_lib_release "${_diligent_prefix}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}${name}${CMAKE_STATIC_LIBRARY_SUFFIX}")
    set(_lib_debug "${_diligent_prefix}/debug/lib/${CMAKE_STATIC_LIBRARY_PREFIX}${name}${CMAKE_STATIC_LIBRARY_SUFFIX}")
    if(NOT EXISTS "${_lib_release}" AND NOT EXISTS "${_lib_debug}")
        return()
    endif()

    add_library(unofficial::diligent-engine::${name} STATIC IMPORTED)
    set_target_properties(unofficial::diligent-engine::${name} PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_diligent_include_dirs}"
        INTERFACE_COMPILE_DEFINITIONS "${_diligent_definitions}"
    )
    if(EXISTS "${_lib_release}")
        set_property(TARGET unofficial::diligent-engine::${name} APPEND PROPERTY
            IMPORTED_CONFIGURATIONS RELEASE)
        set_target_properties(unofficial::diligent-engine::${name} PROPERTIES
            IMPORTED_LOCATION_RELEASE "${_lib_release}")
        # Fallback for consumers configuring with a config we have no mapping for.
        set_target_properties(unofficial::diligent-engine::${name} PROPERTIES
            IMPORTED_LOCATION "${_lib_release}")
    endif()
    if(EXISTS "${_lib_debug}")
        set_property(TARGET unofficial::diligent-engine::${name} APPEND PROPERTY
            IMPORTED_CONFIGURATIONS DEBUG)
        set_target_properties(unofficial::diligent-engine::${name} PROPERTIES
            IMPORTED_LOCATION_DEBUG "${_lib_debug}")
        if(NOT EXISTS "${_lib_release}")
            set_target_properties(unofficial::diligent-engine::${name} PROPERTIES
                IMPORTED_LOCATION "${_lib_debug}")
        endif()
    endif()
endfunction()

_diligent_add_module(DiligentCore)
_diligent_add_module(DiligentTools)
_diligent_add_module(DiligentFX)

if(NOT TARGET unofficial::diligent-engine::DiligentCore)
    set(unofficial-diligent-engine_FOUND FALSE)
    set(unofficial-diligent-engine_NOT_FOUND_MESSAGE
        "DiligentCore library not found under ${_diligent_prefix}")
    return()
endif()

# System libraries the engine links against but that a static archive cannot record.
set(_diligent_system_libs "")
if(APPLE)
    foreach(_fw Cocoa Foundation Metal QuartzCore IOKit IOSurface AppKit)
        find_library(_diligent_fw_${_fw} ${_fw})
        if(_diligent_fw_${_fw})
            list(APPEND _diligent_system_libs "${_diligent_fw_${_fw}}")
        endif()
    endforeach()
    # Linked unconditionally: an unused framework only costs a load command, and
    # this file has no visibility into which backends the port was built with.
    find_library(_diligent_fw_OpenGL OpenGL)
    if(_diligent_fw_OpenGL)
        list(APPEND _diligent_system_libs "${_diligent_fw_OpenGL}")
    endif()
elseif(UNIX)
    find_package(Threads QUIET)
    if(TARGET Threads::Threads)
        list(APPEND _diligent_system_libs Threads::Threads)
    endif()
    list(APPEND _diligent_system_libs ${CMAKE_DL_LIBS})
elseif(WIN32)
    list(APPEND _diligent_system_libs dxgi.lib d3dcompiler.lib Shlwapi.lib)
endif()

if(_diligent_system_libs)
    set_property(TARGET unofficial::diligent-engine::DiligentCore APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES "${_diligent_system_libs}")
endif()

# DiligentFX and DiligentTools both build on top of DiligentCore.
foreach(_module DiligentTools DiligentFX)
    if(TARGET unofficial::diligent-engine::${_module})
        set_property(TARGET unofficial::diligent-engine::${_module} APPEND PROPERTY
            INTERFACE_LINK_LIBRARIES unofficial::diligent-engine::DiligentCore)
    endif()
endforeach()
if(TARGET unofficial::diligent-engine::DiligentFX AND TARGET unofficial::diligent-engine::DiligentTools)
    set_property(TARGET unofficial::diligent-engine::DiligentFX APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES unofficial::diligent-engine::DiligentTools)
endif()
