diff --git a/BUILD.gn b/BUILD.gn
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -1348,7 +1348,18 @@
 
   # SkRawCodec catches any exceptions thrown by dng_sdk, insulating the rest of
   # Skia.
-  configs = [ "gn/portable:add_exceptions" ]
+  #
+  # Run-time type information is on for the same reason it is on for dng_sdk
+  # itself. A translation unit compiled without it that catches or throws a
+  # standard exception emits a private, non-unique copy of that type's
+  # typeinfo, and the linker satisfies every other object's reference to the
+  # name with that copy. The handler search compares a typeinfo by address, so
+  # a `catch (const std::exception &)` anywhere in an image holding this object
+  # then matches nothing the standard library throws.
+  configs = [
+    "gn/portable:add_exceptions",
+    "gn/portable:add_rtti",
+  ]
 
   sources = [ "src/codec/SkRawCodec.cpp" ]
 }
